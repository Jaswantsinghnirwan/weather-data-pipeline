# Copy this file to .env and fill in your values before running.
# All values have sensible defaults; the only one you MUST set is WEBHOOK_URL.

# ── Webhook ───────────────────────────────────────────────────────────────────
# 1. Go to https://webhook.site
# 2. Copy your unique URL (e.g. https://webhook.site/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)
# 3. Paste it below
WEBHOOK_URL=https://webhook.site/YOUR-UNIQUE-ID-HERE

# ── Location (defaults to Paris, France) ─────────────────────────────────────
LATITUDE=48.8566
LONGITUDE=2.3522

# ── Alert thresholds ──────────────────────────────────────────────────────────
HEAT_THRESHOLD=35.0     # Fire HEAT_ALERT when temp >= this value (°C)
FREEZE_THRESHOLD=0.0    # Fire FREEZE_ALERT when temp <= this value (°C)
SPIKE_DELTA=5.0         # Fire SPIKE_ALERT when |change| >= this value (°C)

# ── Scheduling ────────────────────────────────────────────────────────────────
POLL_INTERVAL=600       # Seconds between API polls (600 = 10 minutes)
